NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=marketplace_dev
DB_TEST_NAME=marketplace_test
APP_BASE_URL=http://localhost:5173
MAIL_DRIVER=log
AUTH_RATE_LIMIT_MAX=10
# Temporarily disabled: accounts are active immediately. Set to true to require the emailed link.
REQUIRE_EMAIL_VERIFICATION=false
# Encrypts KYC PII. This value is a throwaway for local development only.
# Production: generate your own with `openssl rand -base64 32` and keep it in a secret manager.
PII_ENCRYPTION_KEY=ZGV2LW9ubHktbm90LXNlY3JldC0wMTIzNDU2Nzg5YWI=
STORAGE_DRIVER=local
STORAGE_DIR=./storage

{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "coverage": "vitest run --coverage",
    "migrate": "tsx src/db/cli.ts latest",
    "migrate:rollback": "tsx src/db/cli.ts rollback",
    "migrate:test": "NODE_ENV=test tsx src/db/cli.ts latest",
    "seed:dev": "tsx src/db/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
